# Copy to server/.env for local runs, or pass these to the container.

# Where Music is reachable (Spotify redirect, links).
PUBLIC_URL=https://music.bayfield.dev
PORT=8791

# PostgreSQL. Docker Compose sets this for you; for local development without Docker,
# `npm run db:dev` starts a local Postgres on this address.
DATABASE_URL=postgres://postgres:music@127.0.0.1:5434/postgres
# DATABASE_POOL_MAX=10

# --- Spotify: sign-in and history (required) ---
# The same variables as YourSpotify: reuse its app from https://developer.spotify.com/dashboard.
# Add this redirect URI to the app: ${PUBLIC_URL}/api/oauth/spotify/callback
SPOTIFY_PUBLIC=
SPOTIFY_SECRET=
# Only if the redirect URI has to be something else:
# SPOTIFY_REDIRECT_URI=https://music.bayfield.dev/api/oauth/spotify/callback
# How often recently played tracks are fetched (Spotify only remembers the last 50).
# POLL_INTERVAL_SECONDS=120
# The time zone of users who haven't picked one (YourSpotify's TIMEZONE).
# TIMEZONE=Europe/Paris

# Hosts that answer the API at the root, like YourSpotify's separate API server
# (e.g. your old API_ENDPOINT's host pointed at this container), comma-separated.
# COMPAT_HOSTS=api.music.bayfield.dev

# Local development without Spotify: sign straight in as this user (created if missing).
# Only honoured when PUBLIC_URL is http://localhost; leave unset everywhere else.
# DEV_LOGIN_USER=demo
# Idle days before a session expires.
# SESSION_IDLE_DAYS=30

# Where uploaded Spotify data exports wait while they're imported.
# IMPORT_DIR=/tmp/music-imports

# Prometheus metrics at /api/metrics (YourSpotify's variables). Off when unset.
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=

# Header your reverse proxy puts the visitor IP in, used for rate limiting
# (behind a Cloudflare Tunnel: cf-connecting-ip).
# CLIENT_IP_HEADER=cf-connecting-ip

# Look on GitHub for a newer release, shown in Settings → About (cached for 6 hours).
# UPDATE_CHECK=true
